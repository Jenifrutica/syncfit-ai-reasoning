# SyncFit AI Reasoning - environment template
# Copy to `.env` and fill in your OpenCode key. `.env` is git-ignored.

# OpenCode account key (shared by Go and Zen). Required.
REASONING_API_KEY=

# Product: "go" (default) or "zen". Selects the endpoint.
REASONING_PRODUCT=go

# Primary model id and model used after a transient primary-provider failure.
REASONING_MODEL=deepseek-v4-pro
REASONING_FALLBACK_MODEL=gpt-6-luna

# If the configured product rejects the key, try the other product automatically.
REASONING_AUTO_PRODUCT_FALLBACK=true

# Optional overrides.
# REASONING_BASE_URL=https://opencode.ai/zen/go/v1
# REASONING_TEMPERATURE=0.1
# REASONING_TIMEOUT=60
